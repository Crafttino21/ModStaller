{
  "name": "modstaller-gui",
  "productName": "ModStaller",
  "version": "1.1.0-beta.3",
  "description": "iOS-Sideloader fuer Linux und Windows",
  "private": true,
  "main": "electron/main.cjs",
  "desktopName": "modstaller-gui.desktop",
  "type": "module",
  "author": "ModStaller",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test electron/notes.test.cjs",
    "dist": "vite build && electron-builder --linux AppImage --publish never",
    "dist:win": "vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
